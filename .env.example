# These go in Netlify: Site configuration > Environment variables.
# Copy this file to .env for local `netlify dev` work only. The real .env
# is gitignored and must never be committed.
#
# None of these ever reach a browser. The only two values that are safe in
# a browser are the Supabase URL and anon key, and those live in config.js.

# console.anthropic.com. Put a monthly spend limit on the key while you are
# in there: a brief costs pennies, a loop costs pounds.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Optional. Check the console for the current model id.
ANTHROPIC_MODEL=

# Supabase > Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxx

# Stripe > Developers > Webhooks > your endpoint > signing secret.
# Test mode and live mode have different ones. Swapping to live means
# changing this and redeploying, or the webhook returns 400.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# Invent this yourself. Long and random. It is the only thing stopping
# anyone from running up your API bill by hitting /api/build-site.
BUILD_KEY=

# resend.com > API Keys. Used by the Stripe webhook to send the buyer
# a welcome email and Karla a job notification.
RESEND_API_KEY=re_xxxxxxxx

# Where job notifications land. Karla's real inbox.
OWNER_EMAIL=
